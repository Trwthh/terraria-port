# THREE-PLAYER, PASSWORD variant (written by make_mp3_scripts.py from mp_join.input): player Joiner, types
# the server password potato7 at the password prompt, digs the tile 2 2 relative to the spawn.
# terraria (translated client), process B of the multiplayer proof: first run with an EMPTY save root -> language
# -> title -> Multiplayer -> Join via IP -> New player "Joiner" -> address 127.0.0.1 -> port 47800 -> in the
# world of the server process A started. Digs the ground tile two to the right of the spawn, walks right, waits
# for the chat message of A, leaves through Save & Exit.
frame 900 mouse 640 360
frame 1010 mouse 640 247
frame 1030 click left
frame 1100 mouse 900 600
frame 1200 dump menu
# title menu: 1 Multiplayer
frame 1210 aim menu 1
frame 1230 click left
frame 1290 dump menu
# multiplayer menu: 0 Join via IP
frame 1300 aim menu 0
frame 1320 click left
frame 1390 dump ui
frame 1400 mouse 807 650
frame 1420 click left
frame 1500 mouse 770 533
frame 1520 click left
frame 1590 text Joiner
frame 1630 text \n
frame 1730 dump ui
frame 1740 aim snap Play 0
frame 1760 click left
frame 1830 dump ui
frame 1830 dump net
frame 1835 shot ../work/shots/mp3_b0_ip_prompt.png
# the address prompt is empty on a first run: typed, Enter
frame 1870 text 127.0.0.1
frame 1900 text \n
frame 1960 dump ui
frame 1960 dump net
frame 1965 shot ../work/shots/mp3_b1_port_prompt.png
# the port prompt starts with "7777"
# (the game reads Backspace as a key, not as typed text: four presses remove "7777")
frame 1970 key Back down
frame 1973 key Back up
frame 1976 key Back down
frame 1979 key Back up
frame 1982 key Back down
frame 1985 key Back up
frame 1988 key Back down
frame 1991 key Back up
frame 2000 text 47800
frame 2030 text \n
# the server asks for its password (NetMessage 37 -> Main.menuMode 31): typed, Enter
frame 2040 wait 600 menumode 31
frame 2045 dump ui
frame 2050 shot ../work/shots/mp3_b_password.png
frame 2055 text potato7
frame 2058 text \n
frame 2060 dump net
frame 2070 wait 600 ingame
frame 2130 dump net
frame 2130 dump players
frame 2130 dump world
frame 2140 shot ../work/shots/mp3_b2_ingame.png
frame 2150 wait 600 players 3
# dig: copper pickaxe (hotbar 2), the mouse held on the ground tile two to the right of the spawn
frame 2200 key D2 press
frame 2230 dump tile rel 2 2
frame 2240 aim rel 2 2
frame 2250 button left down
frame 2251 wait 60 tile rel 2 2 inactive
frame 2260 button left up
frame 2270 dump tile rel 2 2
frame 2280 shot ../work/shots/mp3_b3_dug.png
# walk right for three seconds
frame 2300 key D down
frame 2480 key D up
frame 2490 dump player
frame 2500 shot ../work/shots/mp3_b4_walked.png
# the chat message of A
frame 2510 wait 300 chat hello from A
frame 2520 dump chat
frame 2570 shot ../work/shots/mp3_b5_chat_received.png
# leave: inventory (Escape), the Settings button, Save & Exit
frame 2600 key Escape press
frame 2630 aim settings
frame 2640 click left
frame 2675 shot ../work/shots/mp3_b6_settings.png
frame 2680 aim ui 414 517
frame 2690 click left
frame 2700 wait 120 menu
frame 2800 dump net
frame 2810 shot ../work/shots/mp3_b7_title_after_leaving.png
frame 2860 quit
