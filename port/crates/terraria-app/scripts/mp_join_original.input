# terraria (translated client) against the ORIGINAL dedicated server (run_original_server.sh starts
# work/refserver/TerrariaServer.exe on 127.0.0.1:47801): first run with an EMPTY save root -> language -> title ->
# Multiplayer -> Join via IP -> New player "Joiner" -> 127.0.0.1 -> 47801 -> in the world. Walks, digs the ground
# tile two to the right of where it stands, says something in the chat, leaves through Save & Exit.
frame 900 mouse 640 360
frame 1010 mouse 640 247
frame 1030 click left
frame 1100 mouse 900 600
frame 1210 aim menu 1
frame 1230 click left
frame 1300 aim menu 0
frame 1320 click left
frame 1400 mouse 807 650
frame 1420 click left
frame 1500 mouse 770 533
frame 1520 click left
frame 1590 text Joiner
frame 1630 text \n
frame 1740 aim snap Play 0
frame 1760 click left
frame 1830 dump net
# the address prompt is empty on a first run: typed, Enter; then the port prompt ("7777")
frame 1870 text 127.0.0.1
frame 1900 text \n
# (the game reads Backspace as a key, not as typed text: four presses remove "7777")
frame 1970 key Back down
frame 1973 key Back up
frame 1976 key Back down
frame 1979 key Back up
frame 1982 key Back down
frame 1985 key Back up
frame 1988 key Back down
frame 1991 key Back up
frame 2000 text 47801
frame 2030 text \n
frame 2060 dump net
frame 2070 wait 600 ingame
frame 2130 dump net
frame 2130 dump players
frame 2130 dump world
frame 2140 shot ../work/shots/mpo_1_ingame.png
# dig: copper pickaxe (hotbar 2), the mouse held on the ground tile two to the right of the spawn
frame 2200 key D2 press
frame 2230 dump tile rel 2 2
frame 2240 aim rel 2 2
frame 2250 button left down
frame 2251 wait 60 tile rel 2 2 inactive
frame 2260 button left up
frame 2270 dump tile rel 2 2
frame 2280 shot ../work/shots/mpo_2_dug.png
# walk right for three seconds
frame 2300 dump player
frame 2300 key D down
frame 2480 key D up
frame 2490 dump player
frame 2500 shot ../work/shots/mpo_3_walked.png
# chat: Enter opens the chat line, the text, Enter sends it; the server echoes it to every client
frame 2510 key Enter press
frame 2540 text hello from the port
# (the game sends on the typed character 13 while the Enter KEY was up in the frame before: Main.DoUpdate_HandleChat)
frame 2570 text \n
frame 2580 wait 60 chat hello from the port
frame 2590 dump chat
frame 2600 shot ../work/shots/mpo_4_chat.png
# leave: inventory (Escape), the Settings button, Save & Exit
frame 2620 key Escape press
frame 2650 aim settings
frame 2660 click left
frame 2700 aim ui 414 517
frame 2710 click left
frame 2720 wait 120 menu
frame 2800 dump net
frame 2810 shot ../work/shots/mpo_5_title_after_leaving.png
frame 2860 quit
