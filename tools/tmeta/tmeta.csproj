<Project Sdk="Microsoft.NET.Sdk">
  <!-- tmeta: ground truth for the reference database.
       `tmeta meta` reads a .NET assembly's metadata + IL (System.Reflection.Metadata, part of the runtime).
       `tmeta src`  parses the decompiled C# with Roslyn (the copy that ships inside the .NET SDK; nothing is downloaded). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RoslynDir>$(NetCoreSdkRoot)Roslyn\bincore\</RoslynDir>
    <RoslynDir Condition="'$(NetCoreSdkRoot)' == ''">$(MSBuildToolsPath)\Roslyn\bincore\</RoslynDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(RoslynDir)Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(RoslynDir)Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
